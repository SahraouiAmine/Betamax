{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan/UBSan",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BETAMAX_SANITIZE": "ON" }
    },
    {
      "name": "ci",
      "displayName": "CI (Release, -Werror)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BETAMAX_WERROR": "ON" }
    },
    {
      "name": "ci-asan",
      "displayName": "CI (ASan/UBSan, -Werror)",
      "inherits": "asan",
      "cacheVariables": { "BETAMAX_WERROR": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "ci-asan", "configurePreset": "ci-asan" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "ci", "inherits": "base", "configurePreset": "ci" },
    { "name": "ci-asan", "inherits": "base", "configurePreset": "ci-asan" }
  ]
}

#!/usr/bin/env bash
# Refuse to commit C++ files that clang-format would change. Checks the staged
# version of each file (what will actually be committed), not the working copy.
# Enable once per clone:  git config core.hooksPath tools/hooks
# Bypass in an emergency: git commit --no-verify (CI still checks).
set -euo pipefail

if ! command -v clang-format >/dev/null; then
  echo "pre-commit: clang-format not found, skipping format check (see README)" >&2
  exit 0
fi

status=0
while IFS= read -r file; do
  if ! git show ":$file" | clang-format --dry-run --Werror --assume-filename="$file" 2>/dev/null; then
    echo "pre-commit: $file is not formatted" >&2
    status=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.cpp' '*.hpp')

if [[ $status -ne 0 ]]; then
  echo "Run tools/format.sh, then git add the files again." >&2
fi
exit $status
